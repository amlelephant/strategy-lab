# Copy to .env and fill in. .env is gitignored.
#
# Nothing in this repository reads a hardcoded credential, and nothing in a
# backtest reads a credential at all — these are only used by the one-off data
# fetch commands.

# SimFin — rebuilding the fundamentals dataset (updateDataJSON-style pipelines).
# Not needed to run anything against the cached data/ files.
SIMFIN_API_KEY=
SIMFIN_DATA_DIR=./data/simfin

# Where the platform looks for datasets. Defaults to ./data
LAB_DATA_DIR=./data

# Flask. Only set FLASK_DEBUG=1 for local development; it enables the debugger.
FLASK_DEBUG=0
