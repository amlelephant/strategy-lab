# ── secrets ──────────────────────────────────────────────────────────────
.env
*.pem
*.key

# ── bulk data ────────────────────────────────────────────────────────────
# Price and fundamental dumps run to tens of megabytes and are regenerable.
# The directory structure is tracked so a clone still knows where they go.
data/*
!data/.gitkeep
!data/README.md
# The exception: half a megabyte, and every alpha number in this repository is
# measured against it. A benchmark that each clone refetches is a benchmark
# that differs slightly per clone — adjusted closes get restated — which makes
# published results unreproducible for the sake of 0.5 MB.
!data/market_spy.csv
!data/riskfree_3m.csv

# ── generated ────────────────────────────────────────────────────────────
runs/
/live/
*.png
!docs/**/*.png

# ── python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
venv/
.venv/
env/

# ── editors and os ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
